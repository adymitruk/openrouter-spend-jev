[Unit]
Description=Jev-tiered OpenRouter router for Hermes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h keeps this portable; if the distro python has no fastapi/uvicorn/httpx
# (PEP 668 distros), point this at a venv interpreter instead.
ExecStart=/usr/bin/python3 %h/.local/bin/jev-proxy.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
